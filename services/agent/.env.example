DATABASE_URL=postgresql://cratedigger:cratedigger@localhost:5432/cratediggerdb
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=editor@kristenmartino.ai
ENVIRONMENT=development
LOG_LEVEL=info

# Crawler User-Agent (per CLAUDE.md "Do not be aggressive" rule)
CRAWLER_USER_AGENT=Crate Digger Music Digest / kristen@kristenmartino.ai

# Reddit OAuth (script app). Create one at https://www.reddit.com/prefs/apps
# — type "script", any redirect URI. Without these, ingest_method="api"
# sources pointing at reddit.com skip silently.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
