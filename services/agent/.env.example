DATABASE_URL=postgresql://cratedigger:cratedigger@localhost:5432/cratediggerdb
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=editor@kristenmartino.ai

# Optional. Personal-access token from https://www.discogs.com/settings/developers
# Used as a cover-art fallback when MusicBrainz / Cover Art Archive don't have
# the release. Without it, the enrich_metadata pipeline node skips Discogs.
DISCOGS_TOKEN=

# Optional. Spotify Client Credentials (server-to-server only — NOT the
# user-OAuth flow). Generate at https://developer.spotify.com/dashboard.
# Used to search Spotify's catalog for release URLs since MB's
# URL-relationships table is sparse. Without these, most releases won't
# get a Spotify link.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. YouTube Data API v3 key (10K units/day free tier; search.list
# costs 100 units). Catalog fallback for releases where article parsing
# and Spotify search both came up empty. Generate at
# https://console.cloud.google.com → enable YouTube Data API v3.
YOUTUBE_API_KEY=

# Destination inbox for failure alerts (cron route 5xx, agent_run lands
# in 'failed' state). When unset, alerts skip silently.
OPS_ALERT_EMAIL=
ENVIRONMENT=development
LOG_LEVEL=info

# Crawler User-Agent (per CLAUDE.md "Do not be aggressive" rule)
CRAWLER_USER_AGENT=Crate Digger Music Digest / kristen@kristenmartino.ai
