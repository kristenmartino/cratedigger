# ── Database ──────────────────────────────────────────────────────────────
# Local: docker-compose spins up pgvector/pgvector:pg16 on 5432
# Production: Neon connection string (with pgvector extension enabled)
DATABASE_URL=postgresql://cratedigger:cratedigger@localhost:5432/cratediggerdb

# ── LLM ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Embeddings ────────────────────────────────────────────────────────────
VOYAGE_API_KEY=pa-...

# ── Auth (Clerk) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=editor@kristenmartino.ai

# ── Pipeline auth (HMAC) ──────────────────────────────────────────────────
# Strong random string. Sent as X-Pipeline-Key header on internal triggers.
PIPELINE_API_KEY=change-me-in-production

# ── Cron auth (Vercel cron → Railway) ─────────────────────────────────────
CRON_SECRET=change-me-in-production

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=info

# ── Frontend → API URL ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
