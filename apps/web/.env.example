NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

DATABASE_URL=postgresql://cratedigger:cratedigger@localhost:5432/cratediggerdb

# Read API base URL (FastAPI on Railway)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Agent server base URL (FastAPI worker on Railway). The cron route forwards
# its trigger here. Production: https://agent.cratedigger.kristenmartino.ai
AGENT_URL=http://localhost:8001

# App's own URL — used by the sign-out route handler
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel cron auth — Vercel injects "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me-in-production

# Forwarded as X-Pipeline-Key when calling agent. Must match
# services/agent/.env's PIPELINE_API_KEY exactly.
PIPELINE_API_KEY=change-me-in-production

# Resend creds used by the cron route to send ops-failure alerts (cron 5xx
# or per-user trigger failures). Same RESEND_API_KEY as services/agent.
# Without OPS_ALERT_EMAIL set, alerts skip silently — no error path.
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=editor@kristenmartino.ai
OPS_ALERT_EMAIL=
